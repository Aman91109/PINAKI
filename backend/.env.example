# ── Core ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/pinaki
JWT_SECRET=change-me

# ── Daily blog generation ──────────────────────────────────────────────────
# Required. Without it the scheduler does not start and no posts are written.
ANTHROPIC_API_KEY=sk-ant-...

# Kill switch. Set to exactly "false" to stop all generation.
BLOG_AUTOGEN_ENABLED=true

# When to generate. Standard 5-field cron, evaluated in BLOG_AUTOGEN_TZ.
# Default: 06:00 every day, India time.
BLOG_AUTOGEN_CRON=0 6 * * *
BLOG_AUTOGEN_TZ=Asia/Kolkata

# Reasoning depth / cost per post: low | medium | high | xhigh | max.
# medium is a good quality-per-rupee balance for this workload.
BLOG_AUTOGEN_EFFORT=medium

# Shared secret for POST /api/cron/generate-blog, so an external scheduler can
# trigger generation on hosts that sleep idle instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, that route rejects every request.
CRON_SECRET=
